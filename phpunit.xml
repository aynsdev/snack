<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Reverb rather than "null": broadcast channel callbacks are registered
            against whichever driver is resolved at boot, and the null driver's
            auth() is a no-op that would authorize every subscription. Using the
            real Pusher-protocol broadcaster means the channel authorization
            tests exercise the same path Echo does.
        -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="snack-testing"/>
        <env name="REVERB_APP_KEY" value="snack-testing-key"/>
        <env name="REVERB_APP_SECRET" value="snack-testing-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Huddles are switched on for the suite, because "off" is the state
            that needs a test rather than the state to test everything else
            under: `snack.huddles.enabled` derives from the secret being present,
            so leaving these unset would make every huddle test assert a 403 for
            the wrong reason. The one test that covers an unconfigured
            deployment overrides the config itself.

            No LiveKit server is contacted. Tokens are signed locally and their
            claims are asserted on directly, so this secret only has to exist.
        -->
        <env name="LIVEKIT_API_KEY" value="snack-testing-key"/>
        <env name="LIVEKIT_API_SECRET" value="snack-testing-secret"/>
        <env name="LIVEKIT_URL" value="ws://localhost:7880"/>
        <!--
            Snack relies on PostgreSQL-specific features (JSONB, citext, tsvector,
            GIN + trigram + partial indexes), so the test suite runs against a real
            PostgreSQL database rather than SQLite.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="snack_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
