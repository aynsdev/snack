<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Reverb rather than "null": broadcast channel callbacks are registered
            against whichever driver is resolved at boot, and the null driver's
            auth() is a no-op that would authorize every subscription. Using the
            real Pusher-protocol broadcaster means the channel authorization
            tests exercise the same path Echo does.
        -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="snack-testing"/>
        <env name="REVERB_APP_KEY" value="snack-testing-key"/>
        <env name="REVERB_APP_SECRET" value="snack-testing-secret"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Huddles are switched on for the suite, because "off" is the state
            that needs a test rather than the state to test everything else
            under: `snack.huddles.enabled` derives from the secret being present,
            so leaving these unset would make every huddle test assert a 403 for
            the wrong reason. The one test that covers an unconfigured
            deployment overrides the config itself.

            No LiveKit server is contacted. Tokens are signed locally and their
            claims are asserted on directly, so this secret only has to exist.
        -->
        <env name="LIVEKIT_API_KEY" value="snack-testing-key"/>
        <env name="LIVEKIT_API_SECRET" value="snack-testing-secret"/>
        <env name="LIVEKIT_URL" value="ws://localhost:7880"/>
        <!--
            Snack relies on PostgreSQL-specific features (JSONB, citext, tsvector,
            GIN + trigram + partial indexes), so the test suite runs against a real
            PostgreSQL database rather than SQLite.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="snack_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
         | Storage is pinned to the local disks for the same reason the mailer is
         | pinned to "array": the suite must not be able to reach anything real.
         |
         | These are not decoration. The tests fake "local" and "public" by name,
         | so with SNACK_UPLOAD_DISK=spaces in a developer's .env the application
         | wrote past the fake and straight into the live DigitalOcean bucket —
         | one `pest` run put eleven objects in it, including files named .env,
         | while the assertions failed against the empty fake. Whatever a
         | developer or a CI box has configured, the suite writes to disk here.
        -->
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="SNACK_UPLOAD_DISK" value="local"/>
        <env name="SNACK_AVATAR_DISK" value="public"/>
        <!-- Blank, so a misconfigured "spaces" disk cannot authenticate even if
             something reaches for it by name. -->
        <env name="SPACES_KEY" value=""/>
        <env name="SPACES_SECRET" value=""/>
        <env name="SPACES_BUCKET" value=""/>
        <env name="SPACES_ENDPOINT" value=""/>
        <!-- Blank, so no test can reach a real agent dispatcher, and the outbox
             stays off unless a test turns it on for itself. -->
        <env name="SNACK_AGENT_DISPATCHER_URL" value=""/>
        <env name="SNACK_AGENT_DISPATCHER_SECRET" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="SNACK_AGENT_ALLOW_INSECURE" value="false"/>
    </php>
</phpunit>
