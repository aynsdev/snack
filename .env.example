APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

APP_TIMEZONE=Asia/Manila

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Snack needs PostgreSQL: its migrations use citext, pg_trgm, unaccent and tsvector.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snack
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Explicitly false rather than unset. Unset means "match the request", which
# stores Secure cookies while the site is HTTPS — and Chrome then refuses to let
# the HTTP site overwrite them, so every request 419s until cookies are cleared.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
# Laravel's fallback disk, for anything that calls Storage:: without naming one.
# Snack itself never does — uploads and avatars are pointed by SNACK_UPLOAD_DISK
# and SNACK_AVATAR_DISK further down, and changing this moves nothing.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail goes out through Resend. Set MAIL_MAILER=log to write it to the log
# instead, which is what you want locally without an API key — every mail here
# is queued, so a missing key means failed jobs rather than a visible error.
MAIL_MAILER=resend
RESEND_API_KEY=
# Must be on a domain verified in Resend. Use onboarding@resend.dev to test
# before a domain is verified.
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Object storage (DigitalOcean Spaces)
# ---------------------------------------------------------------------------
#
# Left blank locally: the defaults above keep uploads on the local disk, which
# is what you want in development. In production set all of these and switch
# the two disks below.
#
# The key/secret are a Spaces access key, made under API → Spaces Keys. Not a
# DigitalOcean API token — those do not work here.
SPACES_KEY=
SPACES_SECRET=
# The datacentre the bucket lives in: sgp1, nyc3, fra1, …
SPACES_REGION=sgp1
#
# The REGION endpoint, with no bucket name in it. DigitalOcean's control panel
# shows you https://your-bucket.sgp1.digitaloceanspaces.com — that is the
# bucket's URL, not the endpoint, and pasting it here breaks every upload: the
# SDK prepends the bucket again, producing your-bucket.your-bucket.sgp1.… ,
# which fails TLS because the wildcard certificate matches one label, not two.
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
#
# The private bucket. Message attachments and asset library files go here, and
# nothing in it is ever served by URL — every download goes through the app,
# which re-checks who is asking. Keep the bucket itself private: an object in
# here that is reachable without the application defeats the whole permission
# model.
SPACES_BUCKET=
#
# Avatars and workspace logos are public by design — they render beside every
# message, for everyone who can read it. Give them their own bucket if you can,
# so the private one can be locked down at the bucket level; leave this blank
# to share SPACES_BUCKET and rely on per-object ACLs instead.
SPACES_PUBLIC_BUCKET=
# The CDN endpoint for that public bucket, so faces are served from the edge
# rather than billed as origin bandwidth on every page load. Note the `.cdn.`
# — the origin hostname works but skips the CDN.
SPACES_PUBLIC_URL=https://your-bucket.sgp1.cdn.digitaloceanspaces.com
#
# The two switches that actually move the files. Set them together: uploads
# already on the old disk are not migrated by changing these.
#   SNACK_UPLOAD_DISK=spaces
#   SNACK_AVATAR_DISK=spaces_public
SNACK_UPLOAD_DISK=local
SNACK_AVATAR_DISK=public

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Huddles (LiveKit) ---
# Live audio/video. The media server is open source and self-hosted: bring one
# up with `docker compose -f docker-compose.livekit.yml up -d`, which reads
# these same two values out of this file.
#
# Leave LIVEKIT_API_SECRET empty to turn huddles off entirely — the button
# disappears rather than failing to dial.
#
# A throwaway local pair. It must never reach a deployment anyone else can
# reach — anybody holding it can mint a token for any room on the server.
# Generate a real one with:
#
#   docker run --rm livekit/livekit-server generate-keys
#
# The secret is padded to 32 characters because LiveKit logs a security warning
# below that length and starts anyway, which is the worst of both worlds: the
# warning scrolls past during boot and the weak secret stays.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-not-for-anything-real-0
# What the *browser* dials, so it must be reachable from the browser rather than
# from PHP. An HTTPS page cannot open a ws:// socket, so anywhere the site is
# served over TLS this has to be wss:// through a terminating proxy.
LIVEKIT_URL=ws://localhost:7880

# --- Snack ---
SNACK_ALLOW_PUBLIC_REGISTRATION=false

# Who operates this installation, shown on the public legal pages
SNACK_LEGAL_COMPANY="Your Company Inc."
SNACK_LEGAL_COUNTRY="Your Country"
SNACK_LEGAL_CONTACT_EMAIL=privacy@example.com
SNACK_MAX_UPLOAD_SIZE_KB=51200
SNACK_INVITATION_TTL_DAYS=7
SNACK_DEFAULT_WORKSPACE_MEMBER_LIMIT=500
SNACK_PRESENCE_HEARTBEAT_SECONDS=60

# ---------------------------------------------------------------------------
# Bite (the workspace assistant)
# ---------------------------------------------------------------------------
#
# Off unless you say otherwise: Bite sends the messages it is shown to Anthropic,
# and that is not something an installation should start doing because a
# dependency happened to be present. Turning it on without a key does nothing
# useful — Bite checks for both before it answers.
SNACK_BITE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

MAGNIFIC_API_KEY=

# Push notifications to the mobile app. The Expo app's tokens go through Expo's
# push service and need nothing here unless enhanced push security is on.
EXPO_ACCESS_TOKEN=

# Optional: raw FCM tokens (non-Expo clients) via FCM HTTP v1. FCM_CREDENTIALS is
# the path to the service account JSON key, or the JSON itself.
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# App Store / Play Store review account — php artisan db:seed --class=AppReviewSeeder --force
SNACK_APP_REVIEW_EMAIL=appreview@example.com
SNACK_APP_REVIEW_PASSWORD=
SNACK_APP_REVIEW_WORKSPACE=snack-demo

# ---------------------------------------------------------------------------
# Agent dispatcher
# ---------------------------------------------------------------------------
#
# Where Snack sends signed task and agent-channel events for Kusina. Off
# unless both are set. The secret signs every request (X-Snack-Signature, the
# same v1 HMAC scheme incoming webhooks use); give the dispatcher the same
# value. It must be random — hex, base64 or base64url of at least 32 bytes —
# or events stay off and a warning is logged. Generate with either:
#   openssl rand -hex 32
#   openssl rand -base64 32
# Must be https:// unless SNACK_AGENT_ALLOW_INSECURE=true, which is for a
# dispatcher on this machine during development only.
SNACK_AGENT_DISPATCHER_URL=
SNACK_AGENT_DISPATCHER_SECRET=
SNACK_AGENT_ALLOW_INSECURE=false

# Deliveries use their own queue. In production give it a dedicated worker,
# `php artisan queue:work --queue=outbound`, so a dispatcher outage cannot
# hold up chat, and chat cannot hold up deliveries. Nothing is delivered if
# no worker listens on it; the scheduler logs a warning when events back up.
SNACK_AGENT_QUEUE=outbound